# Create a key at https://console.anthropic.com/settings/keys
# Copy this file to .env and paste your key in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional. Only needed in environments that preset ANTHROPIC_BASE_URL to
# something else (e.g. Claude Code's remote containers, which point it at their
# own agent proxy). Pinning it here makes the npm scripts talk to the real API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
